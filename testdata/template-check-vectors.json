{
  "_doc": "Write-time template checks (check_templates in crates/dynv/src/admin.rs, checkTemplates in sdk/crypto-ts/src/admin.ts). `scope` is a list of key prefixes (an MCP --allow-keys like PROXY_*), or null for the CLI owner. `expect` is \"ok\" or a substring of the error. Seventh-pass review: scope and danger checks follow definitions and the dependency graph, not only resolved values.",
  "cases": [
    {"name": "same-valued alias: an agent retargets PROXY_URL to an alias of an out-of-scope secret (values equal today)",
     "before": {"SECRET": {"value": "s3cr3t"}, "PROXY_ALIAS": {"template": "${SECRET}"}, "PROXY_URL": {"value": "s3cr3t"}},
     "after":  {"SECRET": {"value": "s3cr3t"}, "PROXY_ALIAS": {"template": "${SECRET}"}, "PROXY_URL": {"template": "${PROXY_ALIAS}"}},
     "scope": ["PROXY_"], "allow_dangerous": false, "expect": "changes template PROXY_URL, which depends on SECRET"},
    {"name": "same-valued alias: the owner may", "before": {"SECRET": {"value": "s3cr3t"}, "PROXY_ALIAS": {"template": "${SECRET}"}, "PROXY_URL": {"value": "s3cr3t"}},
     "after":  {"SECRET": {"value": "s3cr3t"}, "PROXY_ALIAS": {"template": "${SECRET}"}, "PROXY_URL": {"template": "${PROXY_ALIAS}"}},
     "scope": null, "allow_dangerous": false, "expect": "ok"},
    {"name": "same-valued literal->template on a dependency pulls a secret into an existing in-scope template",
     "before": {"SECRET": {"value": "x"}, "PROXY_A": {"value": "x"}, "PROXY_URL": {"template": "http://${PROXY_A}/"}},
     "after":  {"SECRET": {"value": "x"}, "PROXY_A": {"template": "${SECRET}"}, "PROXY_URL": {"template": "http://${PROXY_A}/"}},
     "scope": ["PROXY_"], "allow_dangerous": false, "expect": "depends on SECRET"},
    {"name": "already-broken template retargeted (still broken) is refused, for the owner too",
     "before": {"SECRET": {"value": "x"}, "PROXY_T": {"template": "${MISSING}"}},
     "after":  {"SECRET": {"value": "x"}, "PROXY_T": {"template": "${SECRET}${MISSING}"}},
     "scope": null, "allow_dangerous": false, "expect": "PROXY_T: references ${MISSING}"},
    {"name": "already-broken template left alone does not block an unrelated write",
     "before": {"T": {"template": "${MISSING}"}, "A": {"value": "1"}},
     "after":  {"T": {"template": "${MISSING}"}, "A": {"value": "2"}},
     "scope": null, "allow_dangerous": false, "expect": "ok"},
    {"name": "already-broken out-of-scope template becomes resolvable through an in-scope write: refused",
     "before": {"SECRET": {"value": "x"}, "PROXY_T": {"template": "${SECRET}${PROXY_MISSING}"}},
     "after":  {"SECRET": {"value": "x"}, "PROXY_T": {"template": "${SECRET}${PROXY_MISSING}"}, "PROXY_MISSING": {"value": ""}},
     "scope": ["PROXY_"], "allow_dangerous": false, "expect": "depends on SECRET"},
    {"name": "dangerous template: a same-valued graph change of its dependency needs the acknowledgement",
     "before": {"HEAP": {"value": "512"}, "HEAP2": {"value": "512"}, "NODE_OPTIONS": {"template": "--max-old-space-size=${HEAP}"}},
     "after":  {"HEAP": {"template": "${HEAP2}"}, "HEAP2": {"value": "512"}, "NODE_OPTIONS": {"template": "--max-old-space-size=${HEAP}"}},
     "scope": null, "allow_dangerous": false, "expect": "NODE_OPTIONS is a template and this write changes its value or definition"},
    {"name": "dangerous template: same-valued graph change with --allow-dangerous",
     "before": {"HEAP": {"value": "512"}, "HEAP2": {"value": "512"}, "NODE_OPTIONS": {"template": "--max-old-space-size=${HEAP}"}},
     "after":  {"HEAP": {"template": "${HEAP2}"}, "HEAP2": {"value": "512"}, "NODE_OPTIONS": {"template": "--max-old-space-size=${HEAP}"}},
     "scope": null, "allow_dangerous": true, "expect": "ok"},
    {"name": "dangerous key turned from literal into a same-valued template",
     "before": {"HEAP": {"value": "512"}, "NODE_OPTIONS": {"value": "--max-old-space-size=512"}},
     "after":  {"HEAP": {"value": "512"}, "NODE_OPTIONS": {"template": "--max-old-space-size=${HEAP}"}},
     "scope": null, "allow_dangerous": false, "expect": "NODE_OPTIONS is a template"},
    {"name": "dangerous value change through a dependency (value-based rule still holds)",
     "before": {"HEAP": {"value": "512"}, "NODE_OPTIONS": {"template": "--max-old-space-size=${HEAP}"}},
     "after":  {"HEAP": {"value": "512 --require /tmp/x.js"}, "NODE_OPTIONS": {"template": "--max-old-space-size=${HEAP}"}},
     "scope": null, "allow_dangerous": false, "expect": "NODE_OPTIONS is a template"},
    {"name": "an unrelated write next to a dangerous template is fine",
     "before": {"HEAP": {"value": "512"}, "OTHER": {"value": "a"}, "NODE_OPTIONS": {"template": "--max-old-space-size=${HEAP}"}},
     "after":  {"HEAP": {"value": "512"}, "OTHER": {"value": "b"}, "NODE_OPTIONS": {"template": "--max-old-space-size=${HEAP}"}},
     "scope": null, "allow_dangerous": false, "expect": "ok"},
    {"name": "an agent's own in-scope template is fine",
     "before": {"PROXY_HOST": {"value": "p"}},
     "after":  {"PROXY_HOST": {"value": "p"}, "PROXY_URL": {"template": "http://${PROXY_HOST}/"}},
     "scope": ["PROXY_"], "allow_dangerous": false, "expect": "ok"},
    {"name": "an agent may not steer an owner's template from inside its scope",
     "before": {"PROXY_HOST": {"value": "p"}, "SECRET": {"value": "s"}, "WEBHOOK": {"template": "https://${PROXY_HOST}/?k=${SECRET}"}},
     "after":  {"PROXY_HOST": {"value": "evil"}, "SECRET": {"value": "s"}, "WEBHOOK": {"template": "https://${PROXY_HOST}/?k=${SECRET}"}},
     "scope": ["PROXY_"], "allow_dangerous": false, "expect": "changes template WEBHOOK; WEBHOOK is outside"},
    {"name": "an agent may not convert an owner's out-of-scope-dependent template to a literal of the same value",
     "before": {"SECRET": {"value": "s"}, "PROXY_URL": {"template": "${SECRET}"}},
     "after":  {"SECRET": {"value": "s"}, "PROXY_URL": {"value": "s"}},
     "scope": ["PROXY_"], "allow_dangerous": false, "expect": "depends on SECRET"},
    {"name": "a template retargeted to a same-valued out-of-scope source",
     "before": {"PROXY_A": {"value": "v"}, "OTHER": {"value": "v"}, "PROXY_URL": {"template": "${PROXY_A}"}},
     "after":  {"PROXY_A": {"value": "v"}, "OTHER": {"value": "v"}, "PROXY_URL": {"template": "${OTHER}"}},
     "scope": ["PROXY_"], "allow_dangerous": false, "expect": "depends on OTHER"}
  ]
}
